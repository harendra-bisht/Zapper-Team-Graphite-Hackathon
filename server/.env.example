PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=certishield-graphite26-jwt-secure-secret-key-32chars
SESSION_SECRET=certishield-graphite26-session-secret-key

# Database: PostgreSQL
# Example PostgreSQL Connection: postgresql://postgres:postgres@localhost:5432/certishield
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/certishield

# Fallback SQLite path for zero-friction local execution if PostgreSQL service is offline
SQLITE_DB_PATH=./src/database/certishield.db
USE_SQLITE_FALLBACK=true

# Pricing & Cost model
COST_PER_CERT_PAISE=10
PRICE_PER_CREDIT_PAISE=100
FREE_CREDITS_PER_INSTITUTION=5
